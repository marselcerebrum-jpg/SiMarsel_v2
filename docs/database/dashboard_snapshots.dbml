// SiMarsel - total harian Downloader, log sinkronisasi, dan snapshot pembanding Dashboard
// Sesuai migration sampai FIX-15-BE-03:
//   2026_11_19_112726_create_dashboard_snapshots_table
// Baseline ERD: https://dbdiagram.io/d/SiMarcel-6abb3d735869425612c21263
// Kontrak baca: docs/transaction-dates-coverage.md (FIX-02-BE-01)

Table platforms {
  id bigint [pk, increment]
  slug varchar(50) [not null, unique]
  name varchar(100) [not null]
  created_at timestamp
  updated_at timestamp
}

Table downloaders {
  id bigint [pk, increment]
  platform_id bigint [not null, ref: > platforms.id]
  date date [not null]
  total bigint [not null, note: 'Total harian terbaru. Tidak berubah oleh FIX-15-BE-03']
  created_at timestamp
  updated_at timestamp

  indexes {
    (platform_id, date) [unique]
  }
}

Table sync_logs {
  id bigint [pk, increment]
  platform_id bigint [not null, ref: > platforms.id]
  sync_type varchar(30) [not null]
  trigger_type varchar(30) [not null]
  date_from date
  date_to date
  status varchar(30) [not null]
  records_fetched int
  records_created int
  records_updated int
  error_message text
  started_at timestamp
  finished_at timestamp [note: 'Jam job selesai. Informasi saja, bukan bukti kelengkapan']
  created_at timestamp
  updated_at timestamp
}

Table dashboard_snapshots {
  id bigint [pk, increment]
  platform_id bigint [not null, ref: > platforms.id, note: 'ON DELETE RESTRICT']
  dataset varchar(30) [not null, note: 'transactions | downloaders (App\\Enums\\DashboardDataset)']
  date_from date [not null, note: 'Awal periode rekap (WIB, inklusif)']
  date_to date [not null, note: 'Akhir periode rekap (WIB, inklusif)']
  cutoff_at datetime [not null, note: 'Jam rekap (WIB): kejadian sebelum jam ini']
  is_complete boolean [not null, default: false, note: 'true = data platform dan dataset ini lengkap sampai cutoff_at saat dicatat. Hanya true yang dipakai sebagai batas lengkap dan pembanding']
  payload json [not null, note: 'Salinan nilai pada cutoff_at. Tidak ditulis ulang saat transactions/downloaders berubah']
  recorded_at datetime [not null, note: 'Waktu catatan disimpan, bukan jam rekap']

  indexes {
    (platform_id, dataset, date_from, date_to, cutoff_at) [unique, name: 'dashboard_snapshots_period_cutoff_unique']
    (dataset, date_from, date_to, is_complete, cutoff_at) [name: 'dashboard_snapshots_complete_cutoff_index', note: 'Pemilihan cutoff lengkap terakhir lintas platform']
  }

  Note: '''
  Struktur payload per dataset (angka satu platform; pembaca menjumlahkan antarplatform):

  dataset = transactions
    Metrik dasar tanggal dibuat (markaz_created_at dalam [date_from, cutoff_at)):
      total_checkouts, purchase_attempts, claim_checkouts, success_purchases,
      unsuccessful_purchases, unknown_status_count, unknown_status_nominal,
      conversion_percentage, is_provisional,
      status_breakdown.{pending,success,expired,failed,canceled}.{count,nominal}
    Metrik dasar tanggal bayar (paid_date + paid_time dalam [date_from, cutoff_at)),
    termasuk pembayaran dari transaksi yang dibuat sebelum date_from:
      success_payments, revenue, nominal_total, average_order_value, unique_buyers
    Kedua kelompok tersimpan berdampingan di level atas, sesuai output
    TransactionAggregationService::aggregate()['metrics'] per basis.

  dataset = downloaders
    total: total kumulatif sampai cutoff_at di seluruh periode
    daily: { "Y-m-d": total kumulatif sampai cutoff_at } untuk setiap tanggal yang tercakup
  '''
}
